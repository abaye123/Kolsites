<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kolsites.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kolsites">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- TitleBar -->
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Image Source="Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="הגדרות Kolsites"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="24,12,24,8" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="48" Height="48" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="הגדרות Kolsites"
                               Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="ניהול כפתורים, מיקום, ומראה"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" Padding="24,8,24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <!-- ערכת נושא -->
                <Expander Header="מראה" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8" Padding="4,8">
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" MinWidth="300"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Tag="System" Content="לפי מצב המערכת"/>
                            <ComboBoxItem Tag="Light"  Content="מצב בהיר"/>
                            <ComboBoxItem Tag="Dark"   Content="מצב כהה"/>
                        </ComboBox>
                    </StackPanel>
                </Expander>

                <!-- מיקום הכפתור הצף -->
                <Expander Header="מיקום הכפתור הצף" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="4,8">
                        <ComboBox x:Name="PositionCombo" HorizontalAlignment="Stretch" MinWidth="300">
                            <ComboBoxItem Tag="TopLeft"      Content="פינה ימנית-עליונה"/>
                            <ComboBoxItem Tag="TopRight"     Content="פינה שמאלית-עליונה"/>
                            <ComboBoxItem Tag="BottomLeft"   Content="פינה ימנית-תחתונה"/>
                            <ComboBoxItem Tag="BottomRight"  Content="פינה שמאלית-תחתונה"/>
                            <ComboBoxItem Tag="LeftCenter"   Content="צד ימין - מרכז"/>
                            <ComboBoxItem Tag="RightCenter"  Content="צד שמאל - מרכז"/>
                            <ComboBoxItem Tag="TopCenter"    Content="מרכז עליון"/>
                            <ComboBoxItem Tag="BottomCenter" Content="מרכז תחתון"/>
                        </ComboBox>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="גודל הכפתור (פיקסלים)"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <NumberBox x:Name="ButtonSizeBox"
                                           Minimum="40" Maximum="200"
                                           SmallChange="5" LargeChange="20"
                                           SpinButtonPlacementMode="Inline"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="מרווח מהקצה (פיקסלים)"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <NumberBox x:Name="ButtonMarginBox"
                                           Minimum="0" Maximum="200"
                                           SmallChange="5" LargeChange="10"
                                           SpinButtonPlacementMode="Inline"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="תווית על הכפתור הצף (אופציונלי)"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBox x:Name="ButtonLabelBox" PlaceholderText="השאר ריק לאייקון בלבד"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- כפתורי האתרים -->
                <Expander Header="כפתורי אתרים בחלון העילי" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,8">
                        <TextBlock Text="גרור פריטים לסידור מחדש. סמן/בטל סימון כדי להפעיל/להשבית."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <ListView x:Name="ButtonsList"
                                  CanReorderItems="True"
                                  AllowDrop="True"
                                  CanDragItems="True"
                                  SelectionMode="Single"
                                  MinHeight="280"
                                  MaxHeight="420"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SiteButton">
                                    <Grid Padding="6,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE700;"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="גרור לסידור מחדש"/>

                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Text="{x:Bind Url, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddButton" Click="AddButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock Text="הוסף"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditButton" Click="EditButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                    <TextBlock Text="ערוך"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScriptsButton" Click="ScriptsButton_Click"
                                    ToolTipService.ToolTip="ניהול סקריפטים שירוצו על האתר (הסרת אלמנטים, פרסומות וכו')">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE943;" FontSize="14"/>
                                    <TextBlock Text="סקריפטים"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveButton" Click="RemoveButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="הסר"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RestoreDefaultsButton" Click="RestoreDefaultsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                    <TextBlock Text="שחזר ברירת מחדל"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- חלון העילי -->
                <Expander Header="החלון העילי" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="4,8">
                        <ToggleSwitch x:Name="ShowKeyboardToggle"
                                      Header="הצג מקלדת וירטואלית"
                                      OnContent="כן" OffContent="לא"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="פריסת מקלדת ברירת מחדל"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <ComboBox x:Name="KeyboardLayoutCombo" HorizontalAlignment="Stretch" MinWidth="240">
                                <ComboBoxItem Tag="he"  Content="עברית"/>
                                <ComboBoxItem Tag="en"  Content="אנגלית"/>
                                <ComboBoxItem Tag="num" Content="מספרים"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="גודל המקלדת"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <ComboBox x:Name="KeyboardScaleCombo" HorizontalAlignment="Stretch" MinWidth="240">
                                <ComboBoxItem Tag="1.0" Content="רגיל"/>
                                <ComboBoxItem Tag="1.3" Content="גדול"/>
                                <ComboBoxItem Tag="1.6" Content="גדול מאוד"/>
                                <ComboBoxItem Tag="2.0" Content="ענק"/>
                            </ComboBox>
                            <TextBlock Text="שימושי במסך לאורך - מאפשר מקשים גדולים יותר ומקלדת שתופסת גובה רב יותר."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BlockContextMenuToggle"
                                      Header="חסום תפריט הקשר ימני בדפדפן"
                                      OnContent="כן" OffContent="לא"/>
                        <ToggleSwitch x:Name="ClearCacheOnCloseToggle"
                                      Header="נקה cache בעת סגירת החלון העילי"
                                      OnContent="כן" OffContent="לא"/>
                        <StackPanel Spacing="2">
                            <ToggleSwitch x:Name="ShowNoInternetOverlayToggle"
                                          Header="הצג מסך מלא של 'אין אינטרנט' כשהחיבור מנותק"
                                          OnContent="מסך מלא" OffContent="רק אייקון התראה בסרגל"/>
                            <TextBlock Text="כשמכובה - בעת ניתוק רשת תוצג רק התראה קטנה בסרגל העליון, מה שמתאים יותר לרשתות עם ניתוקים קלים."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="סיסמה לפתיחת ההגדרות מהקיוסק"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="KioskSettingsPasswordBox"
                                             Grid.Column="0"
                                             HorizontalAlignment="Stretch"
                                             PasswordRevealMode="Peek"/>
                                <Button x:Name="ClearKioskPasswordButton"
                                        Grid.Column="1"
                                        Click="ClearKioskPasswordButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                        <TextBlock Text="הסר סיסמה"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="KioskPasswordStatusText"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="הסיסמה נשמרת מוצפנת (PBKDF2-HMAC-SHA256). כשמוגדרת סיסמה - לחיצה כפולה מהירה על האייקון שבחלון 'אודות' של הקיוסק תפתח חלון להזנת הסיסמה ופתיחת ההגדרות. השאר ריק כדי לא לשנות; ל'הסר סיסמה' כדי לנטרל את הקיצור."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- טווחי זמן חסומים -->
                <Expander Header="טווחי זמן חסומים" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,8">
                        <TextBlock Text="הגדר טווחי זמן שבהם לחיצה על הכפתור הצף תציג חלון 'התוכנה לא פעילה כרגע' במקום לפתוח את הקיוסק. ניתן להוסיף כמה טווחים שתרצה."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="AddBlockedRangeButton" Click="AddBlockedRangeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="הוסף טווח חסום"/>
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="BlockedRangesPanel" Spacing="8"/>

                        <TextBlock x:Name="NoBlockedRangesText"
                                   Text="לא הוגדרו טווחים חסומים. התוכנה זמינה תמיד."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </Expander>

                <!-- שליטה בתוכנה -->
                <Expander Header="שליטה בתוכנה" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="4,8">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="הפעלה ועצירה"
                                 Message="כפתור 'סגור' יסיים את כל המופעים של Kolsites במחשב (כולל הכפתור הצף וחלון העילי). ה-Watchdog ייתפעל אותם מחדש בעוד דקה אם הוא פעיל."/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartKioskButton" Click="StartKioskButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="הפעל את Kolsites"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopKioskButton" Click="StopKioskButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                    <TextBlock Text="סגור את Kolsites"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="ProcessStatusText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Expander>

                <!-- אודות -->
                <Expander x:Name="AboutExpander" Header="אודות" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="14" Padding="4,8">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Image Source="Assets/AppIcon.png"
                                   Width="56" Height="56"
                                   VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Kolsites"
                                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <TextBlock x:Name="AboutVersionText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="תוכנת קיוסק לעמדות מחשב ציבוריות"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Image Source="Assets/abaye.png"
                                   Width="56" Height="56"
                                   VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="פותח על ידי abaye"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="קוד פתוח · תרומות ודיווח על באגים מתקבלים בברכה"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <HyperlinkButton Content="abaye.co"
                                                 NavigateUri="https://abaye.co"
                                                 Padding="0"
                                                 Margin="0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton NavigateUri="https://github.com/abaye123/Kolsites">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Path Width="14" Height="14"
                                          Stretch="Uniform"
                                          Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"/>
                                    <TextBlock Text="GitHub: abaye123/Kolsites"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton NavigateUri="https://github.com/abaye123/Kolsites/issues">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEBE8;" FontSize="14"/>
                                    <TextBlock Text="דיווח על באג"/>
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- אייקון נר נשמה: להבה צהובה מעל גוף נר -->
                                <Viewbox Width="18" Height="18">
                                    <Grid Width="24" Height="24">
                                        <Path Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                              Data="M9,12L9,22L15,22L15,12Z"/>
                                        <Path Fill="{ThemeResource SystemFillColorCautionBrush}"
                                              Data="M12,2C9.5,5 9,7 9,9C9,10.5 10.3,11 12,11C13.7,11 15,10.5 15,9C15,7 14.5,5 12,2Z"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="התוכנה לע&quot;נ ר' משה ב&quot;ר אברהם זצ&quot;ל"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SettingsPathText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <Button x:Name="SaveButton" Content="שמור" Style="{ThemeResource AccentButtonStyle}"
                        MinWidth="110" Click="SaveButton_Click"/>
                <Button x:Name="CancelButton" Content="ביטול" MinWidth="110" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
