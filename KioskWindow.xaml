<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kolsites.KioskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kolsites"
    xmlns:webview2="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Site buttons strip -->
            <RowDefinition Height="*"/>     <!-- WebView2 -->
            <RowDefinition Height="Auto"/>  <!-- Keyboard -->
        </Grid.RowDefinitions>

        <!-- Top toolbar - לוגו, מצב, רענון, סגירה -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.png" Width="28" Height="28"/>
                    <TextBlock Text="Kolsites"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="HomeButton" Click="HomeButton_Click"
                            ToolTipService.ToolTip="חזור לדף הראשי">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE10F;" FontSize="14"/>
                            <TextBlock Text="ראשי"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click"
                            ToolTipService.ToolTip="רענן את הדף">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="רענן"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="KeyboardButton" Click="KeyboardButton_Click"
                            ToolTipService.ToolTip="הצג/הסתר מקלדת">
                        <FontIcon Glyph="&#xE765;" FontSize="14"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            ToolTipService.ToolTip="סגור וחזור לכפתור">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8BB;" FontSize="14"/>
                            <TextBlock Text="סגור"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Site buttons strip -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="12,12">
            <ItemsControl x:Name="SiteButtonsHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- WebView2 + welcome panel -->
        <Grid Grid.Row="2">
            <webview2:WebView2 x:Name="WebView"
                               Visibility="Collapsed"
                               FlowDirection="LeftToRight"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>

            <Border x:Name="WelcomePanel"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16"
                            MaxWidth="600">
                    <Image Source="Assets/AppIcon.png" Width="96" Height="96" HorizontalAlignment="Center"/>
                    <TextBlock Text="ברוכים הבאים"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="בחר באחד הכפתורים שלמעלה כדי לפתוח את האתר המבוקש"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsActive="True" Width="56" Height="56"/>
                <TextBlock Text="טוען את הדף..."
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- No-internet panel -->
            <Border x:Name="NoInternetPanel"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorAltBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            MaxWidth="500">
                    <FontIcon Glyph="&#xE871;" FontSize="64"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="אין חיבור לאינטרנט"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="בדוק את החיבור לרשת ונסה שוב"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- On-screen keyboard -->
        <local:OnScreenKeyboard x:Name="Keyboard" Grid.Row="3" Visibility="Collapsed"/>
    </Grid>
</Window>
